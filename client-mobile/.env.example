# client-mobile/.env.example
#
# Si NO defines estas variables, la app intenta detectar automáticamente la IP
# de tu PC en la red local (a partir del host de Expo Go) y usarla en lugar de
# "localhost" — esto es necesario para que un teléfono físico pueda hablar con
# los backends que corren en tu PC. Solo crea un .env con valores explícitos
# si la detección automática no funciona en tu red (p. ej. VPN, redes con
# aislamiento de clientes, etc.) o si los backends corren en otra máquina.
#
# Recuerda: el Authentication-service (.NET) debe escuchar en 0.0.0.0 (no solo
# "localhost") para aceptar conexiones desde el teléfono — ver
# Authentication-service/auth-service/src/AuthService.Api/Properties/launchSettings.json

# Servicio de autenticación (.NET, puerto 5126)
EXPO_PUBLIC_AUTH_URL=http://localhost:5126/api/v1

# Servicio de administración de restaurantes (Node.js, puerto 3020)
EXPO_PUBLIC_ADMIN_URL=http://localhost:3020/restaurantAdmin/v1

# Servicio de pedidos y reservas (Node.js, puerto 3030)
EXPO_PUBLIC_ORDERS_URL=http://localhost:3030/api

# Servicio de eventos y reportes (Node.js, puerto 3040)
EXPO_PUBLIC_EVENTS_URL=http://localhost:3040/eventService/v1
