# Ejemplo seguro para Docker Compose.
# Copia este archivo a .env.docker y reemplaza los valores reales si es necesario.

# --- BASE DE DATOS PG ---
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5432

# --- BASE DE DATOS MONGO ---
MONGODB_PORT=27017
MONGO_DB_NAME=your_mongo_db_name

# --- PUERTOS EN USO DE SERVICIOS ---
AUTH_SERVICE_PORT=5156
EVENT_SERVICE_PORT=3007
RESTAURANT_ADMIN_PORT=3020
ORDER_TRACKING_PORT=3000
CLIENT_ADMIN_PORT=5173
CLIENT_MOBILE_PORT=8081
CLIENT_MOBILE_EXPO_PORT=19000
CLIENT_MOBILE_EXPO_DEVTOOLS_PORT=19001
CLIENT_MOBILE_EXPO_INSPECTOR_PORT=19002

# --- CONFIGURACIONES JWT ---
JWT_SECRET=replace_me_with_a_strong_secret
JWT_ISSUER=FoodPilot
JWT_AUDIENCE=FoodPilot

# --- CONFIGURACIONES FRONTEND URLS ---
FRONTEND_URL=http://localhost:5173
VITE_AUTH_URL=http://localhost:5156
VITE_EVENT_URL=http://localhost:3007
VITE_RESTAURANT_URL=http://localhost:3020
VITE_ORDER_TRACKING_URL=http://localhost:3000
VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/

# --- URLS INTERNAS DOCKER ---
AUTH_SERVICE_URL=http://auth-service:5156

# --- CONFIGURACIÓN MÓVIL / EXPO ---
EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:3007
EXPO_PUBLIC_USER_URL=http://10.0.2.2:3000
EXPO_PACKAGER_HOSTNAME=10.0.2.2

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/
CLOUDINARY_FOLDER=your_folder
CLOUDINARY_DEFAULT_AVATAR_FILENAME=avatarDefault.png
CLOUDINARY_DEFAULT_AVATAR_PATH=avatarDefault.png
CLOUDINARY_TEAMS_FOLDER=your_team_folder

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USE_IMPLICIT_SSL=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=FoodPilot Soporte
